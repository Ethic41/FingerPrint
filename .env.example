# Local XAMPP defaults. Do not commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fingerprint
DB_USER=root
DB_PASSWORD=

# XAMPP + local Docker:
FP_CLIENT_SERVICE_HOST=http://127.0.0.1:5555
FP_CLIENT_TIMEOUT=15
DIAGNOSTICS_ENABLED=1

# Hosted PHP example (use a private HTTPS service):
# FP_CLIENT_SERVICE_HOST=https://fingerprint-service.example.com
